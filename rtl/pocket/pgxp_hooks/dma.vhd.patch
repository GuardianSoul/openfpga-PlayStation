+   function pgxp_guard(r:std_logic_vector(63 downto 0);v:std_logic_vector(31 downto 0)) return pgxp_meta is
+      variable m:pgxp_meta:=PGXP_NONE;
+   begin
+      if r(40)='1' and r(15 downto 0)=v(15 downto 0) then m(8):='1';m(3 downto 0):=r(35 downto 32);end if;
+      if r(41)='1' and r(31 downto 16)=v(31 downto 16) then m(9):='1';m(7 downto 4):=r(39 downto 36);end if;
