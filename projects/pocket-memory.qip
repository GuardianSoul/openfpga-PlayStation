# Source bundle for the memory component. The eventual Pocket project still
# needs APF integration, device/pin assignments and validated SDC constraints.
foreach source {
    psx_mem_clocks.sv psx_mem_pocket.sv psx_mem_arb.sv psx_mem_bridge.sv
    psx_sdram.sv psx_sdram_pins.sv psx_sdr_phy.sv
    psx_pgate_mem.sv psx_mem_cdc.sv psx_pgate_memory.sv
} {
    set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) .. rtl memory $source]
}
set_global_assignment -name SYSTEMVERILOG_FILE [file join $::quartus(qip_path) .. references MIRLO64 rtl soc sdr_ctrl.sv]
