new file mode 100644
index 0000000..774b0f0
--- /dev/null
+++ b/census.c
@@ -0,0 +1,116 @@
+/* Hardware-usage census for PSX_Pocket feature planning. */
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#define NV 16
+typedef struct { uint64_t w, r; uint32_t or_, and_; uint32_t vals[NV]; int nv; } reg_t;
+static reg_t io[0x2000]; static uint64_t exp1_r, exp1_w, exp3;
+static uint64_t gp0[256], gp0_combo[256][4][4][2], gp0_dither[256][2], gp1[64];
+static uint32_t gp1_vals[64][NV]; static int gp1_nv[64];
+static uint64_t cdcmd[256], xa_sectors, cdda_frames, mdec_cmd[8];
+static uint32_t tw_seen; static uint64_t tw_used;
+static void addval(uint32_t *vals, int *nv, uint32_t v){ for(int i=0;i<*nv;i++) if(vals[i]==v) return; if(*nv<NV) vals[(*nv)++]=v; }
+void census_io(uint32_t A, uint32_t V, int write){
+   if(A >= 0x1F801000 && A <= 0x1F802FFF){ reg_t *r=&io[A-0x1F801000];
+      if(write){ if(!r->w) r->and_=V; r->w++; r->or_|=V; r->and_&=V; addval(r->vals,&r->nv,V);} else r->r++; }
+   else if(A >= 0x1F000000 && A <= 0x1F7FFFFF){ if(write) exp1_w++; else exp1_r++; }
+   else if(A >= 0x1FA00000 && A <= 0x1FBFFFFF) exp3++;
+}
+void census_gp0(uint32_t cc, uint32_t abr, uint32_t texmode, int maskeval, int dtd, uint32_t tw){
+   gp0[cc]++; gp0_combo[cc][abr&3][texmode&3][maskeval?1:0]++; gp0_dither[cc][dtd?1:0]++;
+   if(tw){ tw_used++; tw_seen|=tw; }
+}
+void census_gp1(uint32_t cmd, uint32_t v){ gp1[cmd&63]++; addval(gp1_vals[cmd&63],&gp1_nv[cmd&63],v); }
+void census_cdcmd(uint32_t v){ cdcmd[v&255]++; }
+void census_xa(void){ xa_sectors++; }
+void census_cdda(void){ cdda_frames++; }
+void census_mdec(uint32_t command){ mdec_cmd[(command>>29)&7]++; }
+void census_dump(const char *path){
+   FILE *f=fopen(path,"w"); if(!f) return;
+   fprintf(f,"{\n\"io\":{");
+   int first=1;
+   for(int i=0;i<0x2000;i++){ reg_t *r=&io[i]; if(!r->w && !r->r) continue;
+      fprintf(f,"%s\n\"%08X\":{\"w\":%llu,\"r\":%llu,\"or\":%u,\"and\":%u,\"vals\":[",first?"":",",0x1F801000+i,(unsigned long long)r->w,(unsigned long long)r->r,r->or_,r->and_);
+      for(int j=0;j<r->nv;j++) fprintf(f,"%s%u",j?",":"",r->vals[j]); fprintf(f,"]}"); first=0; }
+   fprintf(f,"},\n\"exp1_r\":%llu,\"exp1_w\":%llu,\"exp3\":%llu,\n\"gp0\":{",(unsigned long long)exp1_r,(unsigned long long)exp1_w,(unsigned long long)exp3);
+   first=1; for(int c=0;c<256;c++) if(gp0[c]){ fprintf(f,"%s\"%02X\":{\"n\":%llu,\"dither\":[%llu,%llu],\"combos\":[",first?"":",",c,(unsigned long long)gp0[c],(unsigned long long)gp0_dither[c][0],(unsigned long long)gp0_dither[c][1]);
+      int f2=1; for(int a=0;a<4;a++) for(int t=0;t<4;t++) for(int m=0;m<2;m++) if(gp0_combo[c][a][t][m]){ fprintf(f,"%s[%d,%d,%d,%llu]",f2?"":",",a,t,m,(unsigned long long)gp0_combo[c][a][t][m]); f2=0; }
+      fprintf(f,"]}"); first=0; }
+   fprintf(f,"},\n\"texwindow_draws\":%llu,\"texwindow_bits\":%u,\n\"gp1\":{",(unsigned long long)tw_used,tw_seen);
+   first=1; for(int c=0;c<64;c++) if(gp1[c]){ fprintf(f,"%s\"%02X\":{\"n\":%llu,\"vals\":[",first?"":",",c,(unsigned long long)gp1[c]);
+      for(int j=0;j<gp1_nv[c];j++) fprintf(f,"%s%u",j?",":"",gp1_vals[c][j]); fprintf(f,"]}"); first=0; }
+   fprintf(f,"},\n\"cd_commands\":{"); first=1;
+   for(int c=0;c<256;c++) if(cdcmd[c]){ fprintf(f,"%s\"%02X\":%llu",first?"":",",c,(unsigned long long)cdcmd[c]); first=0; }
+   fprintf(f,"},\n\"xa_sectors\":%llu,\"cdda_frames\":%llu,\n\"mdec_commands\":[",(unsigned long long)xa_sectors,(unsigned long long)cdda_frames);
+   for(int i=0;i<8;i++) fprintf(f,"%s%llu",i?",":"",(unsigned long long)mdec_cmd[i]);
+   fprintf(f,"]\n}\n"); fclose(f);
+}
+
+/* SPU replay trace: 12-byte records <uint32 sample, uint8 type, uint8 hi, uint16 addr, uint32 value>.
+ * type 1: register write (addr = A & 0x3FF), applied before `sample` is computed.
+ * type 2: DMA SPU-RAM write (halfword index = hi<<16 | addr, value = data).
+ * type 3: CD audio input for `sample` (value = L<<16 | R, raw before CD volume).
+ * type 4: final output for `sample` before the 75% resampler attenuation (L<<16 | R). */
+static FILE *spu_trace; static uint32_t spu_sample; static int spu_trace_init;
+static void spu_rec(uint8_t type, uint32_t addr, uint32_t value){
+   if(!spu_trace_init){ const char *p=getenv("PSX_SPU_TRACE"); spu_trace_init=1; if(p) spu_trace=fopen(p,"wb"); }
+   if(!spu_trace) return;
+   uint8_t b[12]; uint16_t a=addr&0xFFFF; uint8_t hi=(addr>>16)&0xFF;
+   memcpy(b,&spu_sample,4); b[4]=type; b[5]=hi; memcpy(b+6,&a,2); memcpy(b+8,&value,4); fwrite(b,1,12,spu_trace);
+}
+void census_spu_write(uint32_t A, uint16_t V){ spu_rec(1, A & 0x3FF, V); }
+void census_spu_dma(uint32_t addr, uint16_t V){ spu_rec(2, addr, V); }
+void census_spu_cd(int32_t l, int32_t r){ spu_rec(3, 0, ((uint32_t)(uint16_t)l<<16)|(uint16_t)r); }
+void census_spu_out(int32_t l, int32_t r){ spu_rec(4, 0, ((uint32_t)(uint16_t)l<<16)|(uint16_t)r); spu_sample++; }
+void census_spu_voice(int32_t pvs, int32_t env, int32_t vl, int32_t vr){
+   spu_rec(5, 0, ((uint32_t)(uint16_t)pvs<<16)|(uint16_t)env); spu_rec(6, 0, ((uint32_t)(uint16_t)vl<<16)|(uint16_t)vr); }
+void census_cd_sector(int32_t lba, int status){ spu_rec(7, (uint32_t)status, (uint32_t)lba); }
+void census_spu_close(void){ if(spu_trace) fclose(spu_trace); spu_trace=NULL; }
+
+/* GPU replay trace: 5-byte records <uint8 type, uint32 value>.
+ * 'W' GP0 word, 'C' GP1 word, 'S' GP0 state word (E1-E6 at the start, not a game write), 'R' GPUREAD word of a VRAM-to-CPU transfer
+ * (value = data read), 'V' VRAM snapshot (value = frame) followed by
+ * 1024*512 little-endian halfwords. Recording starts at the first idle frame
+ * end at or after PSX_GPU_FIRST and stops after PSX_GPU_FRAMES frames;
+ * snapshots are taken at idle frame ends every PSX_GPU_EVERY frames. */
+uint32_t census_cur_cmd, *census_prov;
+static FILE *gpu_trace; static int gpu_trace_init, gpu_recording, gpu_done;
+static uint32_t gpu_frame, gpu_first, gpu_frames = 600, gpu_every = 30, gpu_start;
+extern int GPU_CensusIdle(void); extern const uint16_t *GPU_CensusVRAM(void); extern int GPU_CensusUpscale(void);
+static void gpu_open(void){
+   gpu_trace_init=1; const char *p=getenv("PSX_GPU_TRACE"); if(!p) return;
+   gpu_trace=fopen(p,"wb");
+   if(getenv("PSX_GPU_FIRST")) gpu_first=strtoul(getenv("PSX_GPU_FIRST"),0,0);
+   if(getenv("PSX_GPU_FRAMES")) gpu_frames=strtoul(getenv("PSX_GPU_FRAMES"),0,0);
+   if(getenv("PSX_GPU_EVERY")) gpu_every=strtoul(getenv("PSX_GPU_EVERY"),0,0);
+}
+static void gpu_rec(uint8_t type, uint32_t v){ uint8_t b[5]; b[0]=type; memcpy(b+1,&v,4); fwrite(b,1,5,gpu_trace); }
+static void gpu_snapshot(void){
+   gpu_rec('V', gpu_frame);
+   fwrite(GPU_CensusVRAM(), 2, 1024*512, gpu_trace);
+   if(census_prov){ gpu_rec('P', gpu_frame); fwrite(census_prov, 4, 1024*512, gpu_trace); }
+}
+static uint32_t gpu_words;
+void census_gpu_write(int gp1, uint32_t v){ if(gpu_recording){ gpu_rec(gp1 ? 'C' : 'W', v); if(!gp1) gpu_words++; } }
+/* Index (in recorded GP0 words) of the command now executing: words written minus words still queued minus its length. */
+void census_set_cmd(uint32_t in_count, uint32_t len){ census_cur_cmd = gpu_words - in_count - len; }
+void census_gpu_read(uint32_t v){ if(gpu_recording) gpu_rec('R', v); }
+static uint32_t gpu_dropped;
+void census_gpu_dropped(uint32_t v){ if(gpu_recording){ gpu_dropped++; gpu_rec('D', v); } }
+void census_gpu_frame(void){
+   if(!gpu_trace_init) gpu_open();
+   gpu_frame++;
+   if(!gpu_trace || gpu_done) return;
+   if(GPU_CensusUpscale()){ fprintf(stderr,"GPU trace needs 1x internal resolution\n"); gpu_done=1; return; }
+   if(!gpu_recording){
+      if(gpu_frame >= gpu_first && GPU_CensusIdle()){
+         if(getenv("PSX_GPU_PROV")){ census_prov=calloc(1024*512,4); memset(census_prov,0xFF,1024*512*4); }
+         gpu_recording=1; gpu_start=gpu_frame; gpu_snapshot();
+         { extern void GPU_CensusState(uint32_t*); uint32_t s[7]; GPU_CensusState(s);
+           for(int k=0;k<6;k++) gpu_rec('S', s[k]); gpu_rec('C', s[6]); } }
+      return;
+   }
+   if(gpu_frame - gpu_start >= gpu_frames){ if(GPU_CensusIdle()){ gpu_snapshot(); gpu_recording=0; gpu_done=1; fprintf(stderr,"GPU trace: %u GP0 words dropped on a full FIFO\n",gpu_dropped); fclose(gpu_trace); gpu_trace=NULL; } return; }
+   if((gpu_frame - gpu_start) % gpu_every == 0 && GPU_CensusIdle()) gpu_snapshot();
+}
