+}
+const uint16_t *GPU_CensusVRAM(void) { return GPU.vram; }
+int GPU_CensusUpscale(void) { return GPU.upscale_shift; }
+/* Drawing state as GP0(E1..E6) words plus GP1(04), so a replay can start mid-game. */
+void GPU_CensusState(uint32_t *w)
+{
+   w[0] = 0xE1000000 | (GPU.TexPageX / 64) | ((GPU.TexPageY / 256) << 4) | (GPU.abr << 5) | (GPU.TexMode << 7)
+        | (GPU.dtd << 9) | (GPU.dfe << 10) | (GPU.TexDisable << 11) | (GPU.SpriteFlip & 0x3000);
+   w[1] = 0xE2000000 | GPU.tww | (GPU.twh << 5) | (GPU.twx << 10) | (GPU.twy << 15);
+   w[2] = 0xE3000000 | (GPU.ClipX0 & 1023) | ((GPU.ClipY0 & 1023) << 10);
+   w[3] = 0xE4000000 | (GPU.ClipX1 & 1023) | ((GPU.ClipY1 & 1023) << 10);
+   w[4] = 0xE5000000 | (GPU.OffsX & 2047) | ((GPU.OffsY & 2047) << 11);
+   w[5] = 0xE6000000 | (GPU.MaskSetOR ? 1 : 0) | (GPU.MaskEvalAND ? 2 : 0);
+   w[6] = 0x04000000 | GPU.DMAControl;
+}
